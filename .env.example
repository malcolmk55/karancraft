# ==============================================================================
# MediDoc Environment Variables Template
# راهنمای متغیرهای محیطی برای استقرار تست (Vercel) و استقرار تولید (Liara)
# ==============================================================================

# ------------------------------------------------------------------------------
# ۱. متغیرهای هسته اپلیکیشن (مشترک Vercel و Liara)
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://medidoc.ir

# کلید رمزنگاری جلسات (تولید با دستور: openssl rand -base64 32)
NEXTAUTH_SECRET=your_super_secret_session_encryption_key_here
NEXTAUTH_URL=https://medidoc.ir

# کلید اختصاصی رمزنگاری داده‌های حساس سلامت (AES-256)
HEALTH_DATA_ENCRYPTION_KEY=32_character_hex_or_base64_string_for_aes256

# ------------------------------------------------------------------------------
# ۲. پایگاه داده PostgreSQL (اختصاصی فاز ۲ — هاستینگ لیارا)
# در فاز ۱ (تست ورسل)، نیازی به دیتابیس نیست و سیستم روی LocalStorage و داده‌های شبیه‌سازی‌شده کار می‌کند.
# در هاستینگ لیارا، پس از ایجاد دیتابیس PostgreSQL، این رشته اتصال از پنل لیارا کپی می‌شود:
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@hostname:5432/medidoc_db?sslmode=disable"

# کش Redis (اختیاری — جهت نشست‌ها و سشن‌های همزمان در لیارا)
REDIS_URL="redis://:password@hostname:6379"

# ------------------------------------------------------------------------------
# ۳. درگاه‌های پرداخت ایرانی (سند ۰۸)
# ------------------------------------------------------------------------------
# مرچنت کد زرین‌پال (ZarinPal Merchant ID)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=false

# کد پذیرنده آیدی‌پی (IDPay API Key)
IDPAY_API_KEY=your_idpay_api_key_here
IDPAY_SANDBOX=false

# ------------------------------------------------------------------------------
# ۴. هوش مصنوعی و پردازش صوت با معماری بهینه‌سازی هزینه (Cost-Optimized AI)
# ------------------------------------------------------------------------------
# کلید سرویس تبدیل فوق‌سریع صوت به متن Groq Whisper-Large-V3
GROQ_API_KEY=gsk_your_groq_api_key_here

# کلید سرویس پردازش زبان طبیعی DeepSeek-V3 جهت استخراج داده‌های پزشکی
DEEPSEEK_API_KEY=sk_your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ------------------------------------------------------------------------------
# ۵. احراز هویت دو مرحله‌ای (2FA TOTP — کاملاً رایگان)
# ------------------------------------------------------------------------------
TOTP_APP_NAME="MediDoc Security"
